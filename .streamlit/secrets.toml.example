# 이 파일을 secrets.toml로 복사한 뒤 아래 값을 채우세요 (secrets.toml은 git에 올라가지 않습니다).
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY = "여기에_발급받은_키_붙여넣기"

# (선택) 배포 후 아무나 못 들어오게 막는 앱 비밀번호. 비워두거나 이 줄을 지우면 비밀번호 없이 열림.
# 로컬 테스트 중엔 보통 비워두고, Streamlit Cloud에 배포할 때 Secrets 설정에서만 채우면 됩니다.
APP_PASSWORD = "원하는_비밀번호"

# (선택) 비밀번호 대신/추가로 쓸 수 있는 패턴 입장. 3x3 표(1~9번 칸)를 순서대로 누르는 방식.
# 콤마로 구분된 칸 번호 순서로 지정 (예: 왼쪽 위에서 오른쪽 아래로 대각선 = "1,5,9").
# 둘 다 설정하면 로그인 화면에서 방법을 선택할 수 있고, 하나만 설정하면 그 방법만 나옵니다.
APP_PATTERN = "1,5,9"
